                "method": "GET",
                "path": "/personal/statement/*"
              }
            }
          ],
          "responses": [
            {
              "is": {
                "statusCode": 200,
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": [
                  {
                    "id": "txn_001",
