      "recordRequests": true,
      "stubs": [
        {
          "predicates": [
            {
              "matches": {
                "method": "POST",
                "path": "/api/merchant/invoice/create"
              }
            }
          ],
          "responses": [
            {
              "is": {
                "statusCode": 200,
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "invoiceId": "inv_${{REQUEST.body.orderId}}",
                  "pageUrl": "https://pay.monobank.ua/inv_${{REQUEST.body.orderId}}",
                  "expirationDate": "{{date.now 'unix' 'addHours' 1}}",
                  "qrCode": "base64qr=="
                }
              }
            }
          ]
        },
        {
          "predicates": [
            {
