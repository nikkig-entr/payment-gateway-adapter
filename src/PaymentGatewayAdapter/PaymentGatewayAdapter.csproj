<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageId>PaymentGatewayAdapter</PackageId>
    <Version>1.0.0</Version>
    <Authors>C# Freelance Portfolio</Authors>
    <Description>Production-ready payment gateway adapters for Monobank, LiqPay, Portmone, WayForPay, Stripe, PayPal with idempotency, webhook verification, and reconciliation.</Description>
    <PackageTags>payment;gateway;monobank;liqpay;portmone;wayforpay;stripe;paypal;webhook;idempotency</PackageTags>
    <RepositoryUrl>https://github.com/yourusername/payment-gateway-adapter</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />

    <!-- Resilience -->
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="8.0.10" />
    <PackageReference Include="Polly.Extensions.Http" Version="3.0.0" />

    <!-- Security -->
    <PackageReference Include="System.Security.Cryptography.Algorithms" Version="4.3.1" />

    <!-- JSON -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />

    <!-- Testing -->
    <PackageReference Include="Moq" Version="4.20.70" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
  </ItemGroup>

</Project>